---
import ListLayout from '@/layouts/ListLayout.astro';
import ArticleCard from '@/components/article/ArticleCard.astro';
import { getPublishedArticles, getArticlesByTag, getAllTags } from '@/lib/articles';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const articles = await getArticlesByTag(tag);
---

<ListLayout
  title={`#${tag} の記事一覧`}
  description={`「${tag}」に関する記事一覧です。`}
  heading={`#${tag}`}
  subheading={`${articles.length}件の記事`}
>
  {
    articles.length === 0 ? (
      <p class="text-center text-zinc-400 py-16">このタグの記事はありません。</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    )
  }
</ListLayout>
