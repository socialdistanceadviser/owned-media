---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  heading: string;
  subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- ページヘッダー -->
    <header class="mb-10 border-b border-zinc-200 pb-8 dark:border-zinc-800">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 sm:text-4xl">
        {heading}
      </h1>
      {
        subheading && (
          <p class="mt-3 text-lg text-zinc-500 dark:text-zinc-400">{subheading}</p>
        )
      }
    </header>
    <slot />
  </div>
</BaseLayout>
