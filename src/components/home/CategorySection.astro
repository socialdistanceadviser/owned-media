---
import type { Article } from '@/lib/articles';
import ArticleCard from '@/components/article/ArticleCard.astro';
import { CATEGORIES, type CategorySlug } from '@/config/site';

interface Props {
  category: CategorySlug;
  articles: Article[];
}

const { category, articles } = Astro.props;
const catInfo = CATEGORIES[category];

const badgeColorMap: Record<string, string> = {
  jitsumu: 'bg-indigo-500',
  'ai-katsuyo': 'bg-sky-500',
  automation: 'bg-emerald-500',
  'law-update': 'bg-amber-500',
  career: 'bg-rose-500',
};
---

{
  articles.length > 0 && (
    <section class="py-10 border-t border-zinc-100 dark:border-zinc-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class={`h-3 w-3 rounded-full ${badgeColorMap[category]}`} aria-hidden="true" />
            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50">{catInfo.label}</h2>
            <span class="hidden sm:block text-sm text-zinc-400 dark:text-zinc-500">{catInfo.description}</span>
          </div>
          <a
            href={`/categories/${category}`}
            class="text-sm text-primary-600 hover:text-primary-700 dark:text-primary-400 transition-colors flex-shrink-0"
          >
            もっと見る →
          </a>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {articles.slice(0, 3).map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </div>
    </section>
  )
}
